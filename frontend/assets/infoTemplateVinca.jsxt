
<SiraTable
    style={{width: "100%", height: "200px"}}
    id="infoTemplateVinca"
    rowSelection={false}
    onCellClicked={props.onCellClicked}
    profile={model.profile}
    columns={[
		{
		  "id" : true,
		  "headerName" : '',
		  "xpath" : "@gml:id",
		  "width" : 30,
		  "cellRenderer" : reactCellRendererFactory(GoToDetail)
		}, {
		  "headerName" : "Id Progetto",
		  "xpath" : "decsiraogc_via_vinca:idProgetto/text()",
		  "width" : 100
		}, {
		  "headerName" : "Titolo Progetto",
		  "xpath" : "decsiraogc_via_vinca:titoloProgetto/text()",
		  "width" : 300
		}, {
		  "headerName" : "Codice Scriva",
		  "xpath" : "decsiraogc_via_vinca:codScriva/text()",
		  "width" : 110
		}, {
		  "headerName" : "Codice Adempimento",
		  "xpath" : "decsiraogc_via_vinca:codAdempimento/text()",
		  "width" : 140
		}, {
		  "headerName" : "Codice Istanza",
		  "xpath" : "decsiraogc_via_vinca:codIstanza/text()",
		  "width" : 110
		}, {
		  "headerName" : "Stato Istanza",
		  "xpath" : "decsiraogc_via_vinca:desStatoIstanza/text()",
		  "width" : 110
		}
    ]}
    features={model.getValue("/wfs:FeatureCollection/gml:featureMembers/decsiraogc_via_vinca:ProgettoViaVinca")}/>
